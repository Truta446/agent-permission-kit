{
  "name": "agent-permission-kit",
  "version": "0.2.0",
  "description": "Give your AI agents permissions, not unlimited access. Allow, deny, or require human approval for every tool call — in-process, typed, fail-closed.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "tools",
    "tool-calling",
    "authorization",
    "permissions",
    "policy",
    "human-in-the-loop",
    "approval",
    "mcp",
    "model-context-protocol",
    "security",
    "audit",
    "vercel-ai-sdk",
    "openai-agents",
    "claude-agent-sdk"
  ],
  "license": "MIT",
  "author": "Juan Versolato <juan.versolato@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Truta446/agent-permission-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Truta446/agent-permission-kit/issues"
  },
  "homepage": "https://github.com/Truta446/agent-permission-kit#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/openai-agents.d.ts",
        "default": "./dist/openai-agents.js"
      },
      "require": {
        "types": "./dist/openai-agents.d.cts",
        "default": "./dist/openai-agents.cjs"
      }
    },
    "./claude-agent-sdk": {
      "import": {
        "types": "./dist/claude-agent-sdk.d.ts",
        "default": "./dist/claude-agent-sdk.js"
      },
      "require": {
        "types": "./dist/claude-agent-sdk.d.cts",
        "default": "./dist/claude-agent-sdk.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "./dist/mcp.d.cts"
      ],
      "testing": [
        "./dist/testing.d.cts"
      ],
      "ai-sdk": [
        "./dist/ai-sdk.d.cts"
      ],
      "openai-agents": [
        "./dist/openai-agents.d.cts"
      ],
      "claude-agent-sdk": [
        "./dist/claude-agent-sdk.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:package": "publint --strict && env -u npm_config_dry_run attw --pack .",
    "examples": "node examples/basic/index.ts && node examples/conditional-rules/index.ts && node examples/human-approval/index.ts && node examples/mcp-server/client.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package",
    "bench": "pnpm build && node bench/index.ts"
  },
  "packageManager": "pnpm@10.4.0",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.3.300",
    "@arethetypeswrong/cli": "~0.18.5",
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "~2.3.1",
    "@modelcontextprotocol/sdk": "~1.32.1",
    "@modelcontextprotocol/server": "~2.3.1",
    "@openai/agents": "~0.20.0",
    "@types/node": "^24",
    "@vitest/coverage-v8": "~5.0.4",
    "ai": "~7.0.141",
    "publint": "~0.3.25",
    "tinybench": "~6.2.2",
    "tsdown": "~0.23.1",
    "typescript": "~7.0.2",
    "vitest": "~5.0.4",
    "zod": "^4.6.7"
  }
}
